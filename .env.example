# Copy to .env.local and fill in. .env.local is git-ignored; this file is committed.
# Production values go in Vercel → Project → Settings → Environment Variables.
# How to get each value: docs/setup.md

# --- Supabase ---------------------------------------------------------------
# Local dev: `npm run db:start`, then copy API_URL / PUBLISHABLE_KEY / SECRET_KEY from `npm run db:status`.
# Hosted: Supabase dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
# Safe in the browser (Row-Level Security protects the data). Legacy name: anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses Row-Level Security. Never expose to the browser. Legacy name: service_role key.
SUPABASE_SECRET_KEY=

# --- Google sign-in (local Supabase only) ----------------------------------
# Read by supabase/config.toml via env(). The hosted project stores these in the
# Supabase dashboard instead (Authentication → Sign In / Providers → Google).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Web Push ---------------------------------------------------------------
# Generate a pair: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services: a mailto: or https: URL.
VAPID_SUBJECT=https://github.com/hk2166/CorporatePool

# --- Scheduled jobs ---------------------------------------------------------
# Shared secret pg_cron sends when calling /api/jobs/*. Generate: openssl rand -hex 32
CRON_SECRET=

# --- App ----------------------------------------------------------------------
# true shows an email/password form on /login for the local demo people
# (supabase/seed/20_demo.sql). Never set it in Vercel; the live project only allows Google.
NEXT_PUBLIC_DEV_LOGIN=false
# Used for OAuth redirects and WhatsApp share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
